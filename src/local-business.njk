<section class="hero hero--page">
  <div class="hero__slides" aria-hidden="true">
    <div class="hero__slide is-active">
      {% include "partials/local-ads-video.njk" %}
    </div>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__content container">
    <h1 class="hero__headline" data-split>
      Video that brings local customers
      <span class="flourish">in.</span>
    </h1>
    <p class="hero__lede" data-reveal>
      I'm a film director who has made content for UFC's 650M+ fans. I help
      businesses in the Tri-Cities, Yakima, and Spokane grow their following with a plan, research, and a well-framed shoot.
    </p>
    <a href="#who" class="btn btn--on-media btn--large" data-reveal
      >See who I support</a
    >
  </div>
</section>

<section class="section gl-work" id="local-stories">
  <div class="container">
    <div class="section-head">
      <h2 class="headline" data-split>
        Good Loser Media's <span class="flourish">local work.</span>
      </h2>
    </div>
    <p class="lede gl-work__lede" data-reveal>
      I run Good Loser Media, a documentary studio covering the people and
      issues of Central and Eastern Washington, from the Yakima Valley to
      Spokane. I bring the same care to every local business spot.
    </p>
    <div class="lb-scroller" data-scroller>
      <div class="lb-scroller__nav">
        <button
          type="button"
          class="icon-btn"
          data-scroller-prev
          aria-label="Scroll left"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 5l-7 7 7 7"
            />
          </svg>
        </button>
        <button
          type="button"
          class="icon-btn"
          data-scroller-next
          aria-label="Scroll right"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </button>
      </div>
      <ul class="gl-work__grid" role="list" data-scroller-track>
        {%- for w in glwork %}
        <li class="gl-work__item">
          <a
            href="{{ w.href }}"
            class="gl-work__link"
            target="_blank"
            rel="noopener"
            data-gl-card
          >
            <div class="frame gl-work__frame">
              <img src="{{ w.image }}" alt="" loading="lazy" decoding="async" />
              <iframe
                class="gl-work__preview"
                data-src="{{ w.preview }}"
                title="Preview: {{ w.title }}"
                tabindex="-1"
                aria-hidden="true"
                allow="autoplay; encrypted-media"
              ></iframe>
            </div>
            <p class="label gl-work__place">{{ w.place }}</p>
            <h3 class="gl-work__title">
              {{ w.title
              }}<span class="visually-hidden">
                (opens goodloser.me in a new tab)</span
              >
            </h3>
            <p class="gl-work__copy">{{ w.copy }}</p>
            <span class="gl-work__watch" aria-hidden="true"
              >Watch on goodloser.me <svg class="gl-work__arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4.5 3H9v4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span
            >
          </a>
        </li>
        {%- endfor %}
      </ul>
    </div>
    <p class="section-foot" data-reveal>
      <a
        href="http://goodloser.me"
        class="link-arrow"
        target="_blank"
        rel="noopener"
        >More at goodloser.me</a
      >
    </p>
  </div>
</section>

<section class="section lb-intro" id="who">
  <div class="container">
    <p class="lb-intro__statement" data-reveal>
      Local businesses don't need a bigger budget. They need a plan, and
      strategy crafted by someone who knows and cares about the neighborhood.
    </p>
  </div>
</section>

<section
  class="section lb-stage"
  aria-label="Local business work"
  data-lb-stage
>
  <div class="container grid">
    <div class="span-5 lb-stage__panels">
      {%- for cat in localBusiness %}
      <article
        class="lb-panel{% if loop.first %} is-active{% endif %}"
        data-lb-panel="{{ cat.name }}"
        data-lb-first="{{ cat.videos[0].id }}"
      >
        <div class="lb-panel__body stack">
          <h2 class="headline">{{ cat.name }}</h2>
          <p class="lede">{{ cat.blurb }}</p>
          <ul class="lb-menu" role="list">
            {%- for v in cat.videos %}
            <li>
              <button
                type="button"
                class="lb-menu__item{% if loop.first and cat.name == localBusiness[0].name %} is-active{% endif %}"
                data-lb-select="{{ v.id }}"
              >
                {{ v.business }}
              </button>
            </li>
            {%- endfor %}
          </ul>
        </div>
      </article>
      {%- endfor %}
    </div>

    <div class="span-7 lb-stage__player">
      <div class="lb-stage__sticky">
        <div class="frame lb-stage__frame">
          {%- for cat in localBusiness %} {%- for v in cat.videos %}
          <iframe
            class="lb-layer{% if loop.first and cat.name == localBusiness[0].name %} is-active{% endif %}"
            data-lb-layer="{{ v.id }}"
            data-src="https://iframe.mediadelivery.net/embed/418879/{{
              v.id
            }}?autoplay=true&loop=true&muted=true&preload=true&responsive=true"
            title="{{ v.title }}: {{ v.business }}"
            allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
          ></iframe>
          {%- endfor %} {%- endfor %}
        </div>
        <div class="lb-caption">
          {%- for cat in localBusiness %} {%- for v in cat.videos %}
          <div
            class="lb-caption__item{% if loop.first and cat.name == localBusiness[0].name %} is-active{% endif %}"
            data-lb-caption="{{ v.id }}"
          >
            <p class="lb-caption__title">{{ v.title }}</p>
            <p class="lb-caption__client">{{ v.business }}</p>
            <p class="lb-roles">
              <span class="lb-roles__label">My roles:</span>
              {%- for r in v.roles %}
              <span class="lb-pill">{{ r }}</span>
              {%- endfor %}
            </p>
          </div>
          {%- endfor %} {%- endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section lb-simple" aria-label="Local business work">
  <div class="container">
    {%- for cat in localBusiness %}
    <div class="lb-simple__cat">
      <h2 class="headline">{{ cat.name }}</h2>
      <p class="lede">{{ cat.blurb }}</p>
      <ul class="lb-simple__spots" role="list">
        {%- for v in cat.videos %}
        <li class="lb-simple__spot">
          <div class="frame">
            <iframe
              src="https://iframe.mediadelivery.net/embed/418879/{{
                v.id
              }}?autoplay=false&loop=true&muted=true&preload=false&responsive=true"
              title="{{ v.title }}: {{ v.business }}"
              loading="lazy"
              allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen"
              allowfullscreen
            ></iframe>
          </div>
          <p class="lb-caption__title">{{ v.title }}</p>
          <p class="lb-caption__client">{{ v.business }}</p>
          <p class="lb-roles">
            <span class="lb-roles__label">My roles:</span>
            {%- for r in v.roles %}
            <span class="lb-pill">{{ r }}</span>
            {%- endfor %}
          </p>
        </li>
        {%- endfor %}
      </ul>
    </div>
    {%- endfor %}
  </div>
</section>

<section class="section lb-formats" id="social-first">
  <div class="container">
    <div class="section-head">
      <h2 class="headline" data-split>
        One shoot, a month of <span class="flourish">content.</span>
      </h2>
    </div>
    <div class="lb-math" data-reveal-stagger>
      <p class="lb-math__item" data-reveal>
        <span class="lb-math__num">4</span> hours on set
      </p>
      <p class="lb-math__arrow" aria-hidden="true" data-reveal>→&#xFE0E;</p>
      <p class="lb-math__item" data-reveal>
        <span class="lb-math__num">12</span> reels
      </p>
      <p class="lb-math__arrow" aria-hidden="true" data-reveal>→&#xFE0E;</p>
      <p class="lb-math__item" data-reveal>
        <span class="lb-math__num">30</span> days of posting
      </p>
    </div>
    <p class="lb-disclaimer" data-reveal>
      Every plan is customized to the business. The number of reels, the formats
      and how often you post depend on your goals and your audience. Each
      business gets its own plan.
    </p>
    <p class="lede lb-social__lede" data-reveal>
      One shoot, framed correctly, can be cut for every platform. In my work
      with global brands, social is a priority, without compromising the
      integrity of the feature. Local business shoots follow the same workflow.
    </p>
    <ul class="lb-social__row" role="list" data-reveal-stagger data-play-group>
      <li class="lb-social__item lb-social__item--wide" data-reveal>
        <div class="frame lb-social__frame">
          <video
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            data-inview-play
          >
            <source
              src="/assets/img/videos/social-crucial-times-16x9.mp4"
              type="video/mp4"
            />
          </video>
        </div>
        <p class="lb-format__label">
          <strong>16:9</strong> 
        </p>
      </li>
      <li class="lb-social__item lb-social__item--tall" data-reveal>
        <div class="frame lb-social__frame">
          <video
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            data-inview-play
          >
            <source src="/assets/img/videos/social-punk.mp4" type="video/mp4" />
          </video>
        </div>
        <p class="lb-format__label">
          <strong>9:16</strong> 
        </p>
      </li>
     
    <ul class="lb-proof" role="list" data-reveal>
      <li>
        <strong>Social expertise that delivers,</strong> with big brand social
        experience that translates to local audiences.
      </li>
      <li>
        <strong>A director in touch with the community,</strong> building
        connections and sharing stories through
        <a href="/projects/good-loser/">Good Loser Media</a>.
      </li>
    </ul>
  </div>
</section>

<section class="section lb-craft">
  <div class="container">
    <div class="section-head">
      <h2 class="headline" data-split>
        Research and <span class="flourish">craft.</span>
      </h2>
    </div>
    <ol class="lb-craft__list" role="list" data-reveal-stagger>
      {%- for c in craft %}
      <li class="lb-craft__item" data-reveal>
        <h3 class="lb-craft__title">{{ c.title }}</h3>
        <p class="lb-craft__copy">{{ c.copy }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section lb-area" id="service-area">
  <div class="container">
    <div class="section-head">
      <h2 class="headline" data-split>
        Film direction across Eastern &amp; Central
        <span class="flourish">Washington.</span>
      </h2>
    </div>
    <p class="lede lb-area__lede" data-reveal>
      Video production, commercial direction, and social content for local businesses, nonprofits, and campaigns, shot on location and close to home.
    </p>
    <ul class="lb-area__grid" role="list" data-reveal-stagger>
      <li class="lb-area__place" id="tri-cities" data-reveal>
        <h3>Tri-Cities</h3>
        <p>Richland, West Richland, Kennewick, and Pasco</p>
      </li>
      <li class="lb-area__place" id="yakima" data-reveal><h3>Yakima</h3></li>
      <li class="lb-area__place" id="sunnyside" data-reveal>
        <h3>Sunnyside</h3>
      </li>
      <li class="lb-area__place" id="prosser" data-reveal><h3>Prosser</h3></li>
      <li class="lb-area__place" id="walla-walla" data-reveal>
        <h3>Walla Walla</h3>
      </li>
      <li class="lb-area__place" id="spokane" data-reveal><h3>Spokane</h3></li>
    </ul>
    <p class="section-foot" data-reveal>
      <a href="/contact/" class="btn btn--primary btn--large"
        >Plan your video</a
      >
    </p>
  </div>
</section>
