---
layout: "layouts/site.njk"
title: "Contact"
description: "Start a project with Tifa Jade: film direction, video production, content strategy and photography."
permalink: "/contact/"
---
<section class="section contact">
  <div class="container contact__layout">
    <div class="contact__intro stack">
      <p class="label" data-reveal>Contact</p>
      <h1 class="display" data-split>Let's make something <span class="flourish">great.</span></h1>
      <p class="lede" data-reveal>
        Tell me about the project, even if it's just an idea. I reply within
        one or two business days.
      </p>

      <div class="contact__direct" data-reveal>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <a href="{{ site.calendly }}" class="btn btn--primary btn--large" target="_blank" rel="noopener">Book a 30-minute call</a>
      </div>
    </div>

    {#- Handled by Netlify Forms. Field names match the previous form so
        existing submissions stay together in the Netlify dashboard. -#}
    <form
      class="form"
      name="contact"
      method="POST"
      action="/contact/thanks/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-reveal
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="honeypot" aria-hidden="true">
        <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label for="contact-name">Name</label>
        <input id="contact-name" name="Name" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="contact-email">Email</label>
        <input id="contact-email" type="email" name="email" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="contact-org">Organization <span class="optional">(optional)</span></label>
        <input id="contact-org" name="organization" autocomplete="organization" />
      </div>

      <div class="field">
        <label for="contact-type">What do you need?</label>
        <select id="contact-type" name="project-type">
          <option value="">Choose one</option>
          {%- for s in services %}
          <option>{{ s.title }}</option>
          {%- endfor %}
          <option>Something else</option>
        </select>
      </div>

      <div class="field field--full">
        <label for="contact-message">About the project</label>
        <textarea id="contact-message" name="message text" rows="6" required placeholder="What are you making, who is it for, and when do you need it?"></textarea>
      </div>

      <div class="form__actions">
        <button type="submit" class="btn btn--primary btn--large">Send message</button>
        <p class="meta">Prefer to talk it through? <a href="{{ site.calendly }}" target="_blank" rel="noopener">Book a call</a> instead.</p>
      </div>
    </form>
  </div>
</section>
