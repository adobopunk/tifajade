<footer class="site-footer">
  <div class="container">
    <div class="site-footer__cta">
      <p class="label" data-reveal>Have a project in mind?</p>
      <p class="display" data-split>
        <a href="/contact/">Let's make something <span class="flourish">great.</span></a>
      </p>
      <div class="cluster" data-reveal>
        <a href="{{ site.booking.url }}" class="btn btn--primary btn--large" target="_blank" rel="noopener" data-booking="{{ site.booking.calLink }}">Book a call</a>
        {%- set copyClass = "btn btn--large" %}
        {% include "partials/copy-email.njk" %}
      </div>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__intro">
        <p class="label">Tifa Jade</p>
        <p class="meta" style="margin-top: var(--space-s)">
          Director, producer, and content strategist making films for brands, agencies, local businesses, and campaigns.
        </p>
      </div>

      <div>
        <p class="label">Explore</p>
        <ul>
          {%- for item in site.nav %}{% if not item.hidden %}
          <li><a href="{{ item.url }}" class="link-underline">{{ item.label }}</a></li>{% endif %}
          {%- endfor %}
          <li><a href="/local-business/" class="link-underline">Local business video</a></li>
        </ul>
      </div>

      <div>
        <p class="label">Colophon</p>
        <ul class="meta">
          <li>&copy; {{ "now" | year }} Tifa Jade</li>
          <li>Designed &amp; built by TJ</li>
          {%- if site.showStories %}<li><a href="/feed.xml" class="link-underline">RSS feed</a></li>{% endif %}
        </ul>
      </div>
    </div>
  </div>
</footer>
