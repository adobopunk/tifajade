{#- One project in the grid. Expects `p` (a project page) and optionally
    `eager` for cards in the first rows. The client and title show on hover
    on desktop, and below the image on touch screens. -#}
{%- set posterSrc = p.data.image | poster -%}
{%- set posterSet = posterSrc | srcset -%}
<li class="project-card" data-category="{{ p.data.category }}">
  <a href="{{ p.url }}" class="project-card__link">
    <div class="frame project-card__media">
      <img
        src="{{ posterSrc | sizedImage(1024) }}"
        {% if posterSet %}srcset="{{ posterSet }}" sizes="(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 100vw"{% endif %}
        alt=""
        {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
        decoding="async"
      />
      {%- set sources = p.data.video | videoSources %}
      {%- if sources.length %}
      <video muted loop playsinline preload="none" aria-hidden="true" data-card-video>
        {%- for s in sources %}
        <source src="{{ s.src }}" type="{{ s.type }}" />
        {%- endfor %}
      </video>
      {%- endif %}
      <span class="project-card__overlay" aria-hidden="true">
        <span class="project-card__overlay-client">{{ p.data.client }}</span>
        <span class="project-card__overlay-title">{{ p.data.title }}</span>
      </span>
    </div>
    <div class="project-card__meta">
      <h2 class="project-card__client">{{ p.data.client }}</h2>
      <p class="project-card__title">{{ p.data.title }}</p>
    </div>
  </a>
</li>
