<header class="site-header" data-header {% if headerVariant %}data-variant="{{ headerVariant }}"{% endif %}>
  <div class="site-header__inner container">
    <a href="/" class="site-logo" aria-label="Tifa Jade, home">
      <img class="logo-light" src="/assets/img/logo_lightmode/TifaJade-_Light_Mode-09.png" alt="" width="1102" height="272" />
      <img class="logo-dark" src="/assets/img/logo_darkmode/tifajade_logo.png" alt="" width="1102" height="272" />
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {%- for item in site.nav %}
        <li>
          <a href="{{ item.url }}" class="link-underline"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {%- endfor %}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button type="button" class="btn site-header__reel" data-reel-open>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M4 2.5v11l9-5.5z" /></svg>
        Showreel
      </button>
      <a href="/contact/" class="btn btn--primary site-header__cta">Let's talk</a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
        <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></g></svg>
      </button>
      <button type="button" class="icon-btn site-header__menu-btn" data-menu-open aria-haspopup="dialog" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
</header>
