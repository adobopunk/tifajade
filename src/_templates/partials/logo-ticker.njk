{#- Scrolling strip of client logos, ported from tj.cool. Logos live in
    assets/img/logos as single-colour SVGs, drawn as masks so they follow the
    theme colour. w = display width in rem, ar = width / height. -#}
{%- set logos = [
  { file: "ufc", name: "UFC", w: 3.9, ar: 2.89 },
  { file: "xbox", name: "Xbox", w: 4.2, ar: 3.39 },
  { file: "fortnite", name: "Fortnite", w: 4.8, ar: 3.21 },
  { file: "mountain-dew", name: "Mountain Dew", w: 2.5, ar: 1.437 },
  { file: "intel", name: "Intel", w: 3.9, ar: 2.58 },
  { file: "verizon", name: "Verizon", w: 5.4, ar: 4.46 },
  { file: "porsche", name: "Porsche", w: 7.2, ar: 9.56 },
  { file: "army-national-guard", name: "US Army National Guard", w: 2.3, ar: 0.9 }
] -%}
<section class="logo-ticker" aria-label="Clients">
  <div class="container logo-ticker__inner">
    <p class="label">Delivered for</p>
    <div class="logo-ticker__marquee">
      <div class="logo-ticker__track">
        {%- for copy in [0, 1, 2, 3] %}
        <ul class="logo-ticker__logos"{% if copy > 0 %} aria-hidden="true"{% endif %}>
          {%- for l in logos %}
          <li><span class="logo-ticker__logo"{% if copy == 0 %} role="img" aria-label="{{ l.name }}"{% endif %} style="--logo:url(/assets/img/logos/{{ l.file }}.svg); --w:{{ l.w }}; --ar:{{ l.ar }}"></span></li>
          {%- endfor %}
        </ul>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
