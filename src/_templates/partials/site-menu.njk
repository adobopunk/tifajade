<dialog class="overlay-dialog site-menu" id="site-menu" aria-label="Menu" data-menu>
  <button type="button" class="icon-btn overlay-dialog__close" data-dialog-close aria-label="Close menu">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M6 6l12 12M18 6 6 18" /></svg>
  </button>

  <div class="site-menu__inner container">
    <nav aria-label="Menu">
      <ul class="site-menu__links">
        {%- for item in site.nav %}
        <li style="--i: {{ loop.index0 }}">
          <a href="{{ item.url }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>
            <span class="index">0{{ loop.index }}</span>{{ item.label }}
          </a>
        </li>
        {%- endfor %}
      </ul>
    </nav>

    <div class="site-menu__foot">
      <button type="button" class="btn" style="--btn-fg: #f4f2ed; --btn-border: rgb(244 242 237 / 0.3)" data-reel-open>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M4 2.5v11l9-5.5z" /></svg>
        Watch the showreel
      </button>
      {%- set copyClass = "" %}
      {% include "partials/copy-email.njk" %}
    </div>
  </div>
</dialog>
