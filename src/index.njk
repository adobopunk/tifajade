---
layout: "layouts/site.njk"
description: "Tifa Jade is a film director, video producer and content strategist making work for brands, agencies, local businesses and campaigns."
headerVariant: "overlay"
bodyClass: "page-home"
permalink: "/"
---
{%- set slides = collections.carousel -%}

{#- Featured carousel -#}
<section class="hero" data-carousel aria-roledescription="carousel" aria-label="Featured projects">
  <div class="hero__slides" aria-live="off" data-carousel-track>
    {%- for p in slides %}
    <article
      class="hero__slide{% if loop.first %} is-active{% endif %}"
      data-slide
      aria-roledescription="slide"
      aria-label="{{ loop.index }} of {{ slides.length }}: {{ p.data.client }}"
      {% if not loop.first %}inert{% endif %}
    >
      <video
        class="hero__media"
        muted
        loop
        playsinline
        preload="{{ 'auto' if loop.first else 'none' }}"
        poster="{{ p.data.image | poster }}"
        {% if loop.first %}autoplay{% endif %}
        aria-hidden="true"
      >
        {%- for s in p.data.video | videoSources %}
        <source src="{{ s.src }}" type="{{ s.type }}" />
        {%- endfor %}
      </video>
      <div class="hero__shade" aria-hidden="true"></div>

      <div class="hero__content container">
        <p class="label hero__client">{{ p.data.client }}</p>
        <h2 class="hero__title"><a href="{{ p.url }}">{{ p.data.title }}</a></h2>
        <p class="hero__role">{{ p.data.scope }}</p>
        <a href="{{ p.url }}" class="btn btn--on-media">View project</a>
      </div>
    </article>
    {%- endfor %}
  </div>

  <div class="hero__ui container">
    <p class="hero__count" aria-hidden="true">
      <span data-carousel-current>01</span><span class="hero__count-total"> / {{ slides.length | pad2 }}</span>
    </p>

    <div class="hero__progress">
      {%- for p in slides %}
      <button type="button" class="hero__bar{% if loop.first %} is-active{% endif %}" data-carousel-goto="{{ loop.index0 }}" aria-label="Show {{ p.data.client }}"{% if loop.first %} aria-current="true"{% endif %}>
        <span class="hero__bar-label">{{ p.data.client }}</span>
        <span class="hero__bar-track"><span class="hero__bar-fill"></span></span>
      </button>
      {%- endfor %}
    </div>

    <div class="hero__controls">
      <button type="button" class="icon-btn" data-carousel-prev aria-label="Previous project">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="icon-btn" data-carousel-toggle aria-label="Pause slideshow">
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 4.5v15l12-7.5z" /></svg>
      </button>
      <button type="button" class="icon-btn" data-carousel-next aria-label="Next project">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
</section>

{#- Intro -#}
<section class="section intro">
  <div class="container grid">
    <p class="label span-12" data-reveal>Tifa Jade · Director, Producer &amp; Content Strategist</p>
    <h1 class="headline span-11" data-split>
      Films that move people, for brands, agencies, local businesses and
      <span class="flourish">campaigns.</span>
    </h1>
    <div class="intro__aside span-12 stack" data-reveal>
      <p class="lede">
        A filmmaker of 10+ years, I take ideas from first pitch to final cut
        and plan how they reach people once they're out in the world.
      </p>
      <div class="cluster">
        <button type="button" class="btn btn--primary btn--large" data-reel-open>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M4 2.5v11l9-5.5z" /></svg>
          Watch the showreel
        </button>
        <a href="/contact/" class="btn btn--large">Start a project</a>
      </div>
    </div>
  </div>
</section>

{#- Project grid -#}
{%- set featured = collections.featuredProjects -%}
<section class="section" id="projects" data-project-filter>
  <div class="container">
    <div class="section-head section-head--wrap">
      <h2 class="headline" data-split>Selected <span class="flourish">projects.</span></h2>
      <div class="filters" role="group" aria-label="Filter projects">
        <button type="button" class="filter" data-filter="all" aria-pressed="true">All <sup>{{ featured.length }}</sup></button>
        {%- for cat in ["film", "motion"] %}
        <button type="button" class="filter" data-filter="{{ cat }}" aria-pressed="false">{{ cat | capitalize }} <sup>{{ (featured | byCategory(cat)).length }}</sup></button>
        {%- endfor %}
      </div>
    </div>

    <ul class="project-grid" role="list" data-reveal-stagger>
      {%- for p in featured %}
      {% include "partials/project-card.njk" %}
      {%- endfor %}
    </ul>

    <p class="section-foot" data-reveal>
      <a href="/projects/" class="btn btn--large">All projects</a>
    </p>
  </div>
</section>

{#- Services -#}
<section class="section services" id="services">
  <div class="container">
    <div class="section-head">
      <h2 class="headline" data-split>What I <span class="flourish">do.</span></h2>
      <a href="/services/" class="link-arrow" data-reveal>All services</a>
    </div>

    <div class="service-list">
      {%- for s in services %}
      {%- set sp = collections.animation | bySlug(s.project) if s.project else none %}
      <details class="service" name="services" data-reveal {% if loop.first %}open{% endif %}>
        <summary class="service__summary">
          <span class="index">{{ loop.index | pad2 }}</span>
          <span class="service__title">{{ s.title }}</span>
          <span class="service__icon" aria-hidden="true"></span>
        </summary>
        <div class="service__body">
          <div class="service__text stack">
            <p class="service__desc">{{ s.summary }}</p>
            <ul class="service__deliverables" role="list">
              {%- for d in s.deliverables %}
              <li>{{ d }}</li>
              {%- endfor %}
            </ul>
            {%- if sp %}
            <a href="{{ sp.url }}" class="link-arrow">See {{ sp.data.client }}</a>
            {%- endif %}
          </div>
          <div class="frame service__media">
            {%- if sp %}
            <img src="{{ sp.data.image | poster }}" alt="" loading="lazy" decoding="async" />
            <video muted loop playsinline preload="none" aria-hidden="true" data-service-video>
              {%- for v in sp.data.video | videoSources %}
              <source src="{{ v.src }}" type="{{ v.type }}" />
              {%- endfor %}
            </video>
            {%- elif s.image %}
            <img src="{{ s.image }}" alt="" loading="lazy" decoding="async" />
            {%- endif %}
          </div>
        </div>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>

{#- Clients -#}
<section class="section clients">
  <div class="container">
    <p class="label" data-reveal>Clients &amp; collaborators</p>
    <ul class="client-cloud" role="list" data-reveal-stagger>
      {%- for c in clients %}
      {%- set cp = collections.animation | bySlug(c.project) %}
      <li data-reveal>{% if cp %}<a href="{{ cp.url }}">{{ c.name }}</a>{% else %}{{ c.name }}{% endif %}</li>
      {%- endfor %}
    </ul>
  </div>
</section>
