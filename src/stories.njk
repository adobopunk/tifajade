---
layout: "layouts/site.njk"
title: "Stories"
description: "Photo stories and writing by Tifa Jade."
permalink: "/stories/"
---
{%- set posts = collections.stories | reverse -%}
<section class="section stories-index">
  <div class="container">
    <div class="section-head section-head--wrap">
      <div class="stack">
        <p class="label" data-reveal>Photography &amp; writing</p>
        <h1 class="headline" data-split>Stories from behind the <span class="flourish">lens.</span></h1>
      </div>
      <a href="/feed.xml" class="link-arrow" data-reveal>Follow by RSS</a>
    </div>

    {%- if posts.length %}
    <ul class="story-list" role="list" data-reveal-stagger>
      {%- for post in posts %}
      <li class="story-card{% if loop.first %} story-card--lead{% endif %}" data-reveal>
        <a href="{{ post.url }}" class="story-card__link">
          <div class="frame{% if not loop.first %} frame--portrait{% endif %}">
            {%- if post.data.cover %}
            {%- set src = post.data.cover %}{% set alt = "" %}{% set eager = loop.first %}{% set sizes = "(min-width: 900px) 60vw, 94vw" if loop.first else "(min-width: 900px) 30vw, 94vw" %}
            {% include "partials/story-image.njk" %}
            {%- endif %}
          </div>
          <div class="story-card__text">
            <p class="label">
              {{ post.date | readableDate }}{% if post.data.location %} · {{ post.data.location }}{% endif %}
              {%- if post.data.draft %} · <span class="flourish">draft</span>{% endif %}
            </p>
            <h2 class="story-card__title">{{ post.data.title }}</h2>
            {%- if post.data.description %}<p class="story-card__dek">{{ post.data.description }}</p>{% endif %}
          </div>
        </a>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="lede muted" data-reveal>The first stories are on their way.</p>
    {%- endif %}
  </div>
</section>
